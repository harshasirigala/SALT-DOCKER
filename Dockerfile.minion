ARG BASE_IMAGE
FROM ${BASE_IMAGE}
RUN apt-get update && apt-get install -y curl ca-certificates gnupg procps && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://github.com/saltstack/salt-bootstrap/releases/latest/download/bootstrap-salt.sh -o /tmp/bootstrap-salt.sh \
 && sh /tmp/bootstrap-salt.sh -X -d -A salt-master stable \
 && systemctl enable salt-minion \
 && rm -f /etc/salt/minion_id /etc/salt/pki/minion/minion.*
